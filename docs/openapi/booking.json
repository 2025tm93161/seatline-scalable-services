  "components": {
    "schemas": {
      "Booking": {
        "properties": {
          "event_id": {
            "type": "string",
            "maxLength": 128,
            "minLength": 1,
            "title": "Event Id"
          },
          "quantity": {
            "type": "integer",
            "maximum": 10.0,
            "minimum": 1.0,
            "title": "Quantity"
          },
          "recipient": {
            "type": "string",
            "maxLength": 160,
            "minLength": 3,
            "title": "Recipient"
          },
          "decline_payment": {
            "type": "boolean",
            "title": "Decline Payment",
            "default": false
          },
          "fail_notification": {
            "type": "boolean",
            "title": "Fail Notification",
            "default": false
          },
          "payment_delay_ms": {
            "type": "integer",
            "maximum": 5000.0,
            "minimum": 0.0,
            "title": "Payment Delay Ms",
            "default": 0
          }
        },
        "type": "object",
        "required": [
          "event_id",
          "quantity",
          "recipient"
        ],
        "title": "Booking"
      },
      "ErrorDetail": {
        "properties": {
          "code": {
            "type": "string",
            "title": "Code"
          },
          "message": {
            "type": "string",
            "title": "Message"
          }
        },
        "type": "object",
        "required": [
          "code",
          "message"
        ],
        "title": "ErrorDetail"
      },
      "ErrorResponse": {
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ErrorDetail"
          }
        },
        "type": "object",
        "required": [
